# /etc/systemd/system/skymp.service  (template - adjust paths and ExecStart)
# Verify the entry point in your dist: check build/dist/server/package.json
# "start" script. Community builds use `npm start` in the server folder.
[Unit]
Description=SkyMP (Skyrim Multiplayer) server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=skymp
Group=skymp
WorkingDirectory=/opt/skymp/server
ExecStart=/usr/bin/node skymp5-server.js
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
Environment=NODE_ENV=production
# Uncomment to keep a log file in addition to journald:
# StandardOutput=append:/var/log/skymp/server.log
# StandardError=append:/var/log/skymp/server.log

[Install]
WantedBy=multi-user.target
