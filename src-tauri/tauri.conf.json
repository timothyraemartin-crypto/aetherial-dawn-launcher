{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aetherial Dawn",
  "identifier": "gg.aetherialdawn.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Aetherial Dawn",
        "width": 1360,
        "height": 880,
        "minWidth": 1024,
        "minHeight": 560,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "backgroundColor": "#05080C",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://cdn.discordapp.com https://media.discordapp.net; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser", "installerHooks": "windows/hooks.nsh" },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCQTg1ODVEQjAwNTVBRTEKUldUaFdnV3dYVmlvYTlJMVdHQVQ3L2JOM25NcmFzVGFETXpobkVHRWNMaGR0SDFkUklYWFNSQ3cK",
      "endpoints": [
        "https://github.com/timothyraemartin-crypto/aetherial-dawn-launcher/releases/latest/download/latest.json",
        "https://vps-d38c928e.vps.ovh.us/launcher/app/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
